      DTS:LocaleID="-1"
      DTS:ObjectName="ETL_Load_DIM_Date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{71B88A88-8582-4C7C-BDE4-5BEC8BB4C7D0}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="DECLARE @StartDate DATE, @EndDate DATE;&#xA;&#xA;SELECT&#xA;    @StartDate = MIN(charge_dt),&#xA;    @EndDate   = MAX(charge_dt)&#xA;FROM stg.STG_Charge_SQL;&#xA;&#xA;WITH Dates AS (&#xA;    SELECT @StartDate AS FullDate&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, FullDate)&#xA;    FROM Dates&#xA;    WHERE FullDate &lt; @EndDate&#xA;)&#xA;INSERT INTO dw.DIM_Date (DateKey, FullDate, DayNumber, MonthNumber, MonthName, YearNumber)&#xA;SELECT&#xA;    CONVERT(INT, FORMAT(FullDate, 'yyyyMMdd')),&#xA;    FullDate,&#xA;    DAY(FullDate),&#xA;    MONTH(FullDate),&#xA;    DATENAME(MONTH, FullDate),&#xA;    YEAR(FullDate)&#xA;FROM Dates&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dw.DIM_Date d&#xA;    WHERE d.FullDate = Dates.FullDate&#xA;)&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
